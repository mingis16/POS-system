# Copy to .env.local and fill in. Never commit real keys.

# --- Supabase (required) ------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for: creating staff logins without e-mail, and the cron jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in e-mail confirmation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional white-label name
NEXT_PUBLIC_APP_NAME=SaloneLedger

# --- Cron (weekly reports, alert dispatch) -------------------------------------
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET=

# --- AI Business Advisor (optional) --------------------------------------------
# Without it, the rules-based advisor still runs.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- SMS / WhatsApp alerts (optional, pick one or more) -------------------------
# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Africa's Talking SMS
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Or your own gateway: receives POST {channel, to, body}
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
